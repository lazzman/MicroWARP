+enum target_family_mode {
+	TARGET_FAMILY_AUTO,
+	TARGET_FAMILY_IPV4_ONLY,
+	TARGET_FAMILY_IPV6_ONLY,
+	TARGET_FAMILY_IPV4_PREFER,
+	TARGET_FAMILY_IPV6_PREFER,
+};
+
+/*
+ * 仅供 SOCKS 目标域名解析使用。监听地址和 -b 绑定地址保持 AF_UNSPEC，
+ * 避免 RESOLVE_PREFERENCE 影响服务监听与本地接口解析。
+ */
+static enum target_family_mode target_family_mode(void) {
+	const char *value = getenv("RESOLVE_PREFERENCE");
+	if(!value || !*value || !strcasecmp(value, "auto")) return TARGET_FAMILY_AUTO;
+	if(!strcasecmp(value, "ipv4_only") || !strcasecmp(value, "ipv4") || !strcasecmp(value, "v4"))
+		return TARGET_FAMILY_IPV4_ONLY;
+	if(!strcasecmp(value, "ipv6_only") || !strcasecmp(value, "ipv6") || !strcasecmp(value, "v6"))
+		return TARGET_FAMILY_IPV6_ONLY;
+	if(!strcasecmp(value, "ipv4_prefer") || !strcasecmp(value, "ipv4-prefer"))
+		return TARGET_FAMILY_IPV4_PREFER;
+	if(!strcasecmp(value, "ipv6_prefer") || !strcasecmp(value, "ipv6-prefer"))
+		return TARGET_FAMILY_IPV6_PREFER;
+	return TARGET_FAMILY_AUTO;
+}
+
+static int target_family_filter(void) {
+	switch(target_family_mode()) {
+		case TARGET_FAMILY_IPV4_ONLY: return AF_INET;
+		case TARGET_FAMILY_IPV6_ONLY: return AF_INET6;
+		default: return AF_UNSPEC;
+	}
+}
+
+/* 优先模式仍解析双栈；SOCKS 服务用此值在候选结果中先选目标地址族。 */
+int target_family_preferred(void) {
+	switch(target_family_mode()) {
+		case TARGET_FAMILY_IPV4_PREFER: return AF_INET;
+		case TARGET_FAMILY_IPV6_PREFER: return AF_INET6;
+		default: return AF_UNSPEC;
+	}
+}
