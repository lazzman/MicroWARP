--- a/sockssrv.c
+++ b/sockssrv.c
@@ -125,13 +125,41 @@ static struct addrinfo* addr_choose(struct addrinfo* list, union sockaddr_union*
 	return list;
 }
 
+static struct addrinfo* addr_choose_target(struct addrinfo* list, union sockaddr_union* bindaddr) {
+	int af = SOCKADDR_UNION_AF(bindaddr);
+	if(af != AF_UNSPEC) return addr_choose(list, bindaddr);
+	af = target_family_preferred();
+	if(af != AF_UNSPEC) {
+		struct addrinfo* p;
+		for(p = list; p; p = p->ai_next)
+			if(p->ai_family == af) return p;
+	}
+	return list;
+}
+
+static int connect_addrinfo(struct addrinfo* raddr, union sockaddr_union* bindaddr) {
+	int fd = socket(raddr->ai_family, SOCK_STREAM, 0);
+	if(fd == -1) return -1;
+	if(SOCKADDR_UNION_AF(bindaddr) == raddr->ai_family &&
+	   bindtoip(fd, bindaddr) == -1) goto failed;
+	if(connect(fd, raddr->ai_addr, raddr->ai_addrlen) == -1) goto failed;
+	return fd;
+failed:
+	{
+		int error = errno;
+		close(fd);
+		errno = error;
+	}
+	return -1;
+}
