+/* 成功响应中的 BND.ADDR 必须是已建立远端连接的本地绑定地址。它的地址族
+ * 与实际出站 socket 一致，供内部 LB 准确记录 IPv4 / IPv6 出口；这也符合
+ * RFC 1928 对 CONNECT 成功响应的定义。 */
+static void send_success(int client_fd, int remote_fd) {
+	union sockaddr_union bound = {.v4.sin_family = AF_UNSPEC};
+	socklen_t boundlen = sizeof bound;
+	unsigned char buf[22] = { 5, EC_SUCCESS, 0, 1 /*AT_IPV4*/ };
+	size_t len = 10;
+
+	if(getsockname(remote_fd, (struct sockaddr*) &bound, &boundlen) == 0) {
+		if(SOCKADDR_UNION_AF(&bound) == AF_INET) {
+			memcpy(buf + 4, &bound.v4.sin_addr, 4);
+			memcpy(buf + 8, &bound.v4.sin_port, 2);
+		} else if(SOCKADDR_UNION_AF(&bound) == AF_INET6) {
+			buf[3] = 4 /*AT_IPV6*/;
+			memcpy(buf + 4, &bound.v6.sin6_addr, 16);
+			memcpy(buf + 20, &bound.v6.sin6_port, 2);
+			len = 22;
+		}
+	}
+	write(client_fd, buf, len);
+}
