# ── 基础入口与隧道 ────────────────────────────────────
BIND_PORT=1080
# BIND_ADDR=0.0.0.0
# SOCKS_USER=admin              # 所有模式的公开 SOCKS5 / Mixed 认证；需同时设置 SOCKS_PASS
# SOCKS_PASS=change-me
# TUNNEL_PROTOCOL=wireguard     # wireguard | masque；wireguard 要求宿主机内核存在模块
# 无 WireGuard 模块时：TUNNEL_PROTOCOL=masque、MASQUE_PROXY_MODE=socks、MASQUE_HTTP2=1
# ENABLE_IPV6=1                # 仅启用 WARP IPv6 路由；不决定域名优先 IPv6
# MTU=1280
# KEEPALIVE=15
# ENDPOINT_IP=162.159.192.1:4500
# GH_PROXY=https://example.invalid/
# TAILSCALE_CIDR=100.64.0.0/10
# TAILSCALE_CIDR_V6=fd7a:115c:a1e0::/48
# RESOLVE_PREFERENCE=auto       # auto | ipv4_prefer | ipv6_prefer | ipv4_only | ipv6_only
# prefer 会在优先地址族不可达时回退另一地址族；only 仅解析一种地址族。旧 ipv4 / ipv6 仍兼容，等价于 *_only。
# MASQUE_DNS_SERVERS=1.1.1.1,1.0.0.1
# QUIC/UDP 443 不通时：TUNNEL_PROTOCOL=masque、MASQUE_PROXY_MODE=socks、MASQUE_HTTP2=1

# ── 单容器多实例与 Mixed 代理 ──────────────────────────
# 单实例 SOCKS5 默认不会启动控制面，仍是最低资源的 microsocks 路径。
INSTANCE_COUNT=1
# 基础多实例依次拉起的错峰秒数；默认 0.2，可设 0 追求最快启动，或调大以降低首次注册压力。
INSTANCE_START_STAGGER=0.2
PROXY_MODE=socks5               # socks5 | mixed；mixed 同端口支持 SOCKS5 + HTTP
CONTROL_PLANE_ENABLED=auto      # auto | 1 | 0；Mixed / 多实例 / 管理面板不可设为 0
LB_ENABLED=auto                 # auto | 1 | 0；多实例与管理面板不可关闭
LB_STRATEGY=round               # round | random | hash | rotate
LB_STICKY_MODE=client-ip        # client-ip | username | disabled；username 优先于所有策略（含 rotate），匿名请求才按 LB_STRATEGY 分发
LB_ROTATE_INTERVAL=5m
LB_MAX_CONN=512
LB_ACCESS_LOG=0             # 1=记录请求 ID、客户端地址、用户 ID、目标、实际 IPv4/IPv6 出口及后端；默认仅记录生命周期和异常
# 开启 LB_ACCESS_LOG 后默认记录所有可解析 HTTP 请求头；认证、Cookie、Token 等字段值始终脱敏。
LB_ACCESS_LOG_HEADERS=1     # 0=不记录 HTTP 请求头（仍记录请求行、用户 ID、目标及后端）
LB_ACCESS_LOG_HEADER_MAX_CHARS=8192 # 单条 HTTP 请求头日志最大字符数，范围 256~65536，超出会标记截断
# 单端口匿名管理面板。启用后即使单实例 socks5 也会启动 LB 与控制面：
# http://<宿主机>:${BIND_PORT}/__microwarp/；请仅通过端口绑定或防火墙向可信网络开放。
MANAGEMENT_UI_ENABLED=0
# 网页控制台日志的运行时文件与最大保留行数；日志和临时实例均不会跨容器重启保留。
MICROWARP_LOG_FILE=/run/microwarp/console.log
MANAGEMENT_LOG_LINES=300
# 管理面板启用、优雅重连或强制重连后等待 WARP 探测成功的最大秒数。
# 强制重连跳过连接排空并会中断该实例上的现有代理连接。
MANAGEMENT_ACTION_PROBE_TIMEOUT=180
# 双向无流量超时（不是连接总时长）；LLM 流式首 token / 中间停顿建议至少 600。
# 不要设为 0 或负数，它们不是“关闭超时”。
LB_IDLE_TIMEOUT=600
LB_HANDSHAKE_TIMEOUT=30
# 多实例时通过 /etc/netns/<实例>/resolv.conf 绕开 Docker DNS 127.0.0.11 的命名空间限制。
NETNS_DNS_SERVERS=1.1.1.1,1.0.0.1
# SOCKS_USER / SOCKS_PASS 同时也是 Mixed/LB 公开入口认证；无需另设 PROXY_USER/PASS。
# INTERNAL_PROXY_PORT=1081      # 高级：单实例 Mixed/LB 内部端口，不会发布
# MICROWARP_RUNTIME_ROOT=/run/microwarp  # 高级：控制面临时状态目录

# ── 健康、自愈与滚动重启 ───────────────────────────────
HEALTH_CHECK_INTERVAL=60
HEALTH_PROBE_TIMEOUT=10
# 全局最多并行的实际 HTTP 探测数，避免实例规模较大时瞬间耗尽网络和进程资源
HEALTH_PROBE_CONCURRENCY=32
# 后端池请求会在该窗口内合并后再原子重建，避免数百实例同时就绪时发生锁超时。
BACKEND_POOL_LOCK_TIMEOUT=90
BACKEND_POOL_BATCH_WINDOW_MS=100
HEALTH_SOFT_FAILURES=3
HEALTH_START_PERIOD=90
HEALTH_STARTUP_RETRY_INTERVAL=3
# 1=首次观测及实例状态变化时输出完整图标状态表（含每实例 LB 活跃连接数）；0=关闭表格
# 单实例轻量直连不会经过 LB，因此会显示“活跃连接=—”。
STATUS_EVENT_LOG=1
ROTATE_RESTART_ENABLED=auto      # auto 仅在 INSTANCE_COUNT >= 4 时启用
ROTATE_RESTART_INTERVAL=6h
ROTATE_RESTART_PROBE_TIMEOUT=90
ROTATE_RESTART_RETRIES=2
# auto=当前实例总数的 1/5（至少 1 个）并行；仅空闲实例占用额度，繁忙实例延后至下次检查。
# 正整数可手动覆盖，例如 5。
ROTATE_RESTART_CONCURRENCY=auto
# 延后队列的复查间隔；支持秒数或 1m 等时长，默认每分钟一次。
ROTATE_RESTART_DEFERRED_CHECK_INTERVAL=60
# 管理页执行历史、失败原因与跳过明细的保留轮数；运行时状态随容器重启清理。
ROTATE_RESTART_HISTORY_LIMIT=20

# ── 经 SOCKS5 上游建立 WARP ────────────────────────────
# tun（默认）需要在 compose 中启用 /dev/net/tun；其 udp 需要标准 SOCKS5
# UDP Associate，tcp 是 UDP-in-TCP 扩展，需上游服务端明确支持（如 hev-socks5-server）。
# 标准 TCP-only SOCKS5：仅可设 transport=tcp + masque + socks + MASQUE_HTTP2=1；
# 此分支不需要 /dev/net/tun，且 UPSTREAM_SOCKS5_UDP_MODE 对其无效。
# Linux Docker 访问宿主代理可使用 host.docker.internal（Compose 已映射 host-gateway）。
# UPSTREAM_SOCKS5=socks5://host.docker.internal:20122
# 已验证 LAN SOCKS5：UPSTREAM_SOCKS5=socks5://192.168.1.15:20122
# UPSTREAM_SOCKS5=socks5://user:pass@192.168.1.2:1086
UPSTREAM_SOCKS5_TRANSPORT=tun # tun | tcp；tcp 仅 masque + socks + MASQUE_HTTP2=1
UPSTREAM_SOCKS5_UDP_MODE=udp   # udp | tcp
UPSTREAM_MTU=1280
UPSTREAM_VERIFY=1               # tun 验证 TCP + UDP；tcp 仅验证 TCP CONNECT；失败则阻止直连回退
UPSTREAM_PROBE_TIMEOUT=8
UPSTREAM_REQUIRED=1
# 兼容旧部署的废弃别名：UPSTREAM_SOCKS5_UDP、UPSTREAM_TRANSPORT

# ── MASQUE 可选参数 ─────────────────────────────────────
# MASQUE_PROXY_MODE=l4-socks    # l4-socks | socks
# MASQUE_HTTP2=0
# MASQUE_SNI=
# MASQUE_MTU=
# GOMEMLIMIT=512MiB
# WARP_JWT=
# WARP_LICENSE=
# USQUE_DEVICE_NAME=MicroWARP
# USQUE_CONFIG=/etc/wireguard/masque-config.json

# ── 高级 WireGuard / CI 参数 ────────────────────────────
# WG_CONF=/etc/wireguard/wg0.conf
# WG_IFACE=wg0
# MICROWARP_TEST_MODE=0
